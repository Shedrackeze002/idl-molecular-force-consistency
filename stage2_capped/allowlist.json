      "def _atom_force_norm_max(force):",
      "    \"\"\"f = the largest per-atom Euclidean force norm, in eV/angstrom.\"\"\"",
      "    return float(np.max(np.linalg.norm(force, axis=-1)))",
      "",
      "",
      "def effective_scale(scale, force_norm_max, movement_cap):",
      "    \"\"\"The applied step scale s_eff = min(s, c / f); None means no cap.",
      "",
      "    c / f is in angstrom^2 per eV, the unit of s. The step is then",
      "    s_eff * F, whose largest per-atom length is s_eff * f <= c.",
      "    \"\"\"",
      "    if movement_cap is None:",
      "        return scale",
      "    return min(scale, movement_cap / force_norm_max)",
      "",
      "",
      "def relax_capped(start, force_fn, procedure, *, arm=None, movement_cap_A=None,",
      "                 recorder=None):"
