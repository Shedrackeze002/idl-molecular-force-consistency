      "# Smallest finite movement cap the study accepts, in angstrom.",
      "_MIN_MOVEMENT_CAP_A = 1e-6",
      "",
      "",
      "def _validate_movement_cap(movement_cap_A):",
      "    \"\"\"None or +inf is the uncapped control (returns None); else a finite float.",
      "",
      "    A finite cap must be a real number of at least 1e-6 angstrom. Booleans,",
      "    NaN, zero, negatives and non-numbers are refused.",
      "    \"\"\"",
      "    if movement_cap_A is None:",
      "        return None",
      "    if (isinstance(movement_cap_A, (bool, np.bool_)) or",
      "            not isinstance(movement_cap_A, (int, float, np.integer, np.floating))):",
      "        raise ValueError(\"movement_cap_A must be None or a real number\")",
      "    value = float(movement_cap_A)",
      "    if np.isnan(value) or value < _MIN_MOVEMENT_CAP_A:",
      "        raise ValueError(\"movement_cap_A must be None, inf, or at least 1e-6\")",
      "    return None if value == float(\"inf\") else value",
      "",
      ""
     ]
    },
